{
  "name": "mercadonow",
  "version": "0.0.0",
  "private": true,
  "description": "MercadoNow — fictional billing platform, learning lab for Fullstack/Backend/Architect skills.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @mercadonow/api dev",
    "dev:web": "pnpm --filter @mercadonow/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "eslint": "9.39.2",
    "typescript-eslint": "8.66.0"
  }
}