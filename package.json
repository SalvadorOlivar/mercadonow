{
  "name": "mercadonow",
  "version": "0.0.0",
  "private": true,
  "description": "MercadoNow — fictional billing platform, learning lab for Fullstack/Backend/Architect skills.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @mercadonow/api dev",
    "dev:web": "pnpm --filter @mercadonow/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:architecture": "node scripts/verify-architecture-rules.mjs",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @mercadonow/api test:integration",
    "test:e2e": "pnpm --filter @mercadonow/api test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:architecture && pnpm test && pnpm test:integration && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "eslint": "9.39.2",
    "typescript-eslint": "8.66.0"
  }
}
