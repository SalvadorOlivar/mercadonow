# Copy to .env, replace every replace_with_* placeholder, and never commit .env.
# Loaded by apps/api via @nestjs/config (ConfigModule.forRoot isGlobal).

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=replace_with_local_user
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=replace_with_local_database

# --- API (apps/api) ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://replace_with_local_user:replace_with_local_password@localhost:5432/replace_with_local_database
# Required outside development. Comma-separate explicit HTTP(S) origins; no wildcard.
CORS_ORIGINS=http://localhost:3000
# Exposes Swagger UI at /docs and JSON at /docs-json when true.
OPENAPI_ENABLED=true

# --- Web (apps/web) ---
# Required outside development.
NEXT_PUBLIC_API_URL=http://localhost:3001
