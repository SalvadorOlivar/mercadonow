# Copy to .env and adjust. Never commit .env.
# Loaded by apps/api via @nestjs/config (ConfigModule.forRoot isGlobal).

# --- API (apps/api) ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://mercadonow:mercadonow@localhost:5432/mercadonow
# Required outside development. Comma-separate explicit HTTP(S) origins; no wildcard.
CORS_ORIGINS=http://localhost:3000
# Exposes Swagger UI at /docs and JSON at /docs-json when true.
OPENAPI_ENABLED=true

# --- Web (apps/web) ---
# Required outside development.
NEXT_PUBLIC_API_URL=http://localhost:3001
